---
import '../styles/global.css';

const {
  lang = 'es',
  title = 'ODS para Informática',
  description = '',
  assetBase = './',
  footer = '',
} = Astro.props;

const footerItems = typeof footer === 'object' && footer !== null ? footer : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${assetBase}favicon.svg`} />
    <link rel="icon" href={`${assetBase}favicon.ico`} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    {footerItems && (
      <footer class="footer shell">
        <h2>{footerItems.title}</h2>
        <p class="footer__license-code">{footerItems.shortName}</p>
        <p>
          {footerItems.licensePrefix}
          <a href={footerItems.licenseUrl} target="_blank" rel="noreferrer">
            {footerItems.licenseName}
          </a>
        </p>
        {footerItems.attribution && <p>{footerItems.attribution}</p>}
        <p>{footerItems.thirdPartyLicenses}</p>
        <p>{footerItems.usageVerification}</p>
      </footer>
    )}
  </body>
</html>
